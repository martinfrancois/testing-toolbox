{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "labels": [
    "dependencies"
  ],
  "automergeType": "pr",
  "ignoreTests": false,
  "ignoreUnstable": true,
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "**/vendor/**", "webdriverio/allure-report-reference/**"],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "pinDigests": true,
  "platformAutomerge": false,
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "lockFileMaintenance": {
    "description": "Rewrite each demo's pnpm-lock.yaml every Friday so transitive dependencies pick up published fixes; ordinary updates and vulnerabilityAlerts only reach packages a package.json names. Renovate does not apply minimumReleaseAge here because pnpm regenerates the lockfiles, so pnpm enforces the same seven days through minimumReleaseAge in each pnpm-workspace.yaml, which is what makes automerge safe. Renovate still waits for every check on the branch.",
    "enabled": true,
    "schedule": [
      "* * * * 5"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)README\\.md$/",
        "/^\\.github/scripts/check_all_demos\\.sh$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>artillery|json-server)@(?<currentValue>[0-9][0-9A-Za-z.+-]*)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)README\\.md$/",
        "/^\\.github/scripts/.*\\.sh$/",
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/\\.java$/"
      ],
      "matchStrings": [
        "(?<depName>alpine|gaiaadm/pumba|redis|ghcr\\.io/shopify/toxiproxy|ghcr\\.io/alexei-led/pumba-alpine-nettools):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+[0-9A-Za-z._-]*|latest)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pumba/README\\.md$/",
        "/^\\.github/scripts/check_all_demos\\.sh$/"
      ],
      "matchStrings": [
        "testing-toolbox/pumba-client:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "alpine",
      "depTypeTemplate": "local-image",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)README\\.md$/",
        "/build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "(?:- Java |The Java demos need )JDK (?<currentValue>[0-9]+)",
        "JavaLanguageVersion\\.of\\((?<currentValue>[0-9]+)\\)"
      ],
      "depNameTemplate": "java",
      "datasourceTemplate": "java-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)README\\.md$/"
      ],
      "matchStrings": [
        "Node\\.js v?(?<currentValue>[0-9]+)(?: LTS|\\.(?: |\\r?\\n))"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "description": "Only final npm releases are eligible, even if a registry tags a prerelease as latest.",
      "matchDatasources": ["npm"],
      "allowedVersions": "!/-/"
    },
    {
      "description": "Global CLI pins in the README, preparation script, and CI do not use the local dependency cooldown.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["artillery", "json-server"],
      "minimumReleaseAge": null
    },
    {
      "description": "Merge eligible non-major updates after checks pass; keep unrelated dependencies separate.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Every packageManager field has to name the same pnpm version, so they move in one pull request.",
      "matchPackageNames": [
        "pnpm"
      ],
      "groupName": "pnpm",
      "groupSlug": "pnpm"
    },
    {
      "description": "The WebdriverIO packages are released together and declare each other as peers, so updating part of the set breaks the browser demo. @wdio/globals and @wdio/runner also name the expect-webdriverio major they accept, and a new expect-webdriverio major fits only the WebdriverIO release that raises that range, which is often a minor. Majors and minors therefore share one pull request.",
      "matchPackageNames": [
        "@wdio/**",
        "expect-webdriverio",
        "webdriverio"
      ],
      "groupName": "WebdriverIO",
      "groupSlug": "webdriverio",
      "separateMajorMinor": false
    },
    {
      "description": "The Jest demos differ only in the library each one shows, so their shared test tooling stays on one version.",
      "matchFileNames": [
        "jest-*/package.json"
      ],
      "matchPackageNames": [
        "@swc/core",
        "@swc/jest",
        "@types/jest",
        "jest",
        "typescript"
      ],
      "groupName": "Jest toolchain",
      "groupSlug": "jest-toolchain"
    },

    {
      "description": "Each Java demo carries its own wrapper and all of them have to run on the same Gradle.",
      "matchManagers": [
        "gradle-wrapper"
      ],
      "groupName": "Gradle wrapper",
      "groupSlug": "gradle-wrapper"
    },
    {
      "description": "Update Java runtime requirements and Gradle toolchains together; review LTS eligibility and regenerate lockfiles before merging.",
      "matchDatasources": [
        "java-version"
      ],
      "groupName": "Java runtime",
      "rangeStrategy": "replace",
      "extractVersion": "^(?<version>\\d+)",
      "automerge": false,
      "addLabels": [
        "needs manual sync"
      ]
    },
    {
      "description": "Update Node.js runtime requirements together. Node versioning waits for LTS; review compatibility and regenerate lockfiles before merging.",
      "matchDatasources": [
        "node-version"
      ],
      "groupName": "Node.js runtime",
      "rangeStrategy": "replace",
      "automerge": false,
      "addLabels": [
        "needs manual sync"
      ]
    },
    {
      "description": "Keep runtime declarations at major precision instead of pinning patch releases.",
      "matchDatasources": [
        "java-version",
        "node-version"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "The local Pumba client tag follows its Alpine base image; it has no registry digest of its own.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "local-image"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep the Alpine base, cached client tag, README commands, and CI in one update.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "groupName": "Alpine images"
    },
    {
      "description": "A major update can change what a demo shows on stage, so it waits for a review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ]
    }
  ]
}
