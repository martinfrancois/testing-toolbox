{
  "name": "webdriverio",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@testing-library/webdriverio": "3.2.1",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.13.4",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "9.31.5",
    "@wdio/globals": "9.31.3",
    "@wdio/jasmine-framework": "9.31.5",
    "@wdio/local-runner": "9.31.5",
    "@wdio/spec-reporter": "9.31.2",
    "allure-commandline": "2.43.0",
    "cpy-cli": "^7.0.0",
    "expect-webdriverio": "6.0.10",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "wdio-video-reporter": "^6.2.0",
    "wdio-wait-for": "3.1.1",
    "webdriverio": "9.31.5"
  },
  "scripts": {
    "test": "pnpm run clean:allure-results && pnpm run test:without-report ; pnpm run copy:allure-history ; pnpm run generate:allure-report",
    "report": "allure open",
    "test:without-report": "wdio run ./wdio.conf.ts",
    "clean:allure-results": "rimraf _results_/allure-raw",
    "copy:allure-history": "cpy 'allure-report/history/**' _results_/allure-raw/history",
    "generate:allure-report": "node write-allure-executor.mjs && allure generate --clean _results_/allure-raw"
  }
}
